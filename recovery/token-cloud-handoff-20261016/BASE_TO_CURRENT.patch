+def _sync_directory(path: Path) -> None:
+    """在支持目录同步的平台持久化重命名，Windows 保留文件 fsync 保证。"""
+    if os.name == "nt":
+        return
+    descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
+    try:
+        os.fsync(descriptor)
+    finally:
+        os.close(descriptor)
