+MARKER_PATH = ".task-budget-v1.enabled.json"
+LOCK_PATH = ".task-budget-v1.lock"
+REJECTIONS_PATH = "evidence/task-budget-rejections-v1.json"
+REJECTIONS_SCHEMA = "task-budget-rejections-v1"
