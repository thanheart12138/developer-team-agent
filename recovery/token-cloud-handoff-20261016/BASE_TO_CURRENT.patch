+class TaskBudgetError(RuntimeError):
+    """预算拒绝与模型网络错误分开，调用方不得将其作为 HTTP 重试理由。"""
+
+    def __init__(self, code: str, *, diagnostics: dict | None = None):
+        """保存稳定错误码，异常不包含请求正文、凭据或模型输出。"""
+        self.code = code
+        self.diagnostics = diagnostics
+        super().__init__(code)
